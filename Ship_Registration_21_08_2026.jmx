          <stringProp name="BeanShellSampler.query">import java.util.concurrent.ThreadLocalRandom;

long count1 = ThreadLocalRandom.current().nextLong(1000000, 10000000); // 7-digit
String voy1 = Long.toString(count1);
vars.put(&quot;IMONO&quot;, voy1);

long count2 = ThreadLocalRandom.current().nextLong(1000, 2000); // 7-digit
String voy2 = Long.toString(count2);
vars.put(&quot;BAYAN&quot;, voy2);


long count3 = ThreadLocalRandom.current().nextLong(10000, 20000); // 7-digit
String voy3 = Long.toString(count3);
vars.put(&quot;VoyageCode&quot;, voy3);

long count4 = ThreadLocalRandom.current().nextLong(10000, 20000); // 7-digit
String voy4 = Long.toString(count4);
vars.put(&quot;CARCODE&quot;, voy4);</stringProp>
