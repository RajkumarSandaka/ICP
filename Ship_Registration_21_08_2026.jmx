          <stringProp name="TestPlan.comments">D:\Raj\MMSW</stringProp>
          <stringProp name="BeanShellSampler.query">import org.apache.jmeter.services.FileServer;

String path=FileServer.getFileServer().getBaseDir();

//IMONO= vars.get(&quot;IMO&quot;);      
Username= vars.get(&quot;Username&quot;);
SCNID= vars.get(&quot;scnId&quot;);

f = new FileOutputStream(&quot;D:/FILES/SCN_03_09_1.csv&quot;,true);
p = new PrintStream(f); 

this.interpreter.setOut(p); 
//p.println(IMONO+&quot;,&quot; +CALNO+&quot;,&quot;+VSNAME);
p.println(SCNID+&quot;,&quot;+Username);

f.close();</stringProp>
          <stringProp name="BeanShellSampler.filename"></stringProp>
